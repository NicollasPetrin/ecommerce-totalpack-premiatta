# Copie para .env e ajuste. O .env não vai para o Git.

# Conexão com o PostgreSQL
DATABASE_URL=postgresql://totalpack:senha_local@localhost:5432/totalpack

# Assinatura dos cookies de sessão.
# Gere um valor próprio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-uma-chave-longa-e-aleatoria

# Porta da API. Use API_PORT: alguns ambientes definem PORT para o front.
API_PORT=3333

# Origem do front no desenvolvimento (o Vite)
CORS_ORIGIN=http://localhost:5173

# Credenciais criadas pelo `npm run db:seed`. Troque antes de qualquer uso real.
SEED_ADMIN_EMAIL=admin@totalpack.com.br
SEED_ADMIN_PASSWORD=admin12345
SEED_CUSTOMER_PASSWORD=cliente12345

# ---------------------------------------------------------------------------
# Pagamento
# ---------------------------------------------------------------------------
# 'manual' = sem processadora: PIX e boleto acertados fora do site.
# Ao integrar, troque para o nome do adaptador (ex.: mercadopago) e preencha
# as chaves abaixo.
PAYMENT_PROVIDER=manual

# Chave pública: pode aparecer no navegador (usada em campos tokenizados).
PAYMENT_PUBLIC_KEY=

# Chave secreta: NUNCA vai para o repositório nem para o navegador.
PAYMENT_SECRET_KEY=

# Segredo usado para conferir a assinatura dos webhooks. Sem ele, qualquer
# pessoa que descubra a URL consegue marcar pedidos como pagos.
PAYMENT_WEBHOOK_SECRET=

# Endereço público da loja — usado para montar a URL de retorno do pagamento
# e a URL que você cadastra como webhook na processadora.
# Em produção: https://totalpack.app.br
PUBLIC_URL=http://localhost:5173
